# Server Port (Render/Railway sets PORT automatically)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/skillmatch?retryWrites=true&w=majority

# JWT Secret for authentication tokens (use a long, random secret in production)
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Google Gemini API Key (Get from https://aistudio.google.com/)
GOOGLE_GENAI_API_KEY=your_gemini_api_key

# Frontend URL for CORS and cookie authentication (WITHOUT trailing slash)
# e.g., https://your-app.vercel.app or http://localhost:5173 for local dev
CLIENT_URL=http://localhost:5173
