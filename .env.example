# ==========================================
# SkillMatch AI - Docker Compose Environment
# ==========================================

# 1. Google Gemini API Key (REQUIRED)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (optional, defaults to gemini-2.5-flash or gemini-3-flash-preview)
GEMINI_MODEL=gemini-2.5-flash

# 2. JWT Secret Key (REQUIRED in production)
# Set to any random secret string
JWT_SECRET=super_secret_jwt_key_skillmatch_replace_with_random_string

# 3. MongoDB Connection String
# Option A: Use the included self-hosted Docker MongoDB (Default - no setup required):
MONGO_URI=mongodb://mongo:27017/skillmatch

# Option B: Use MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillmatch?retryWrites=true&w=majority

# 4. Client URL for CORS
# For local deployment: http://localhost or http://localhost:80
# For VPS / domain: https://yourdomain.com
CLIENT_URL=http://localhost

# 5. Port Configuration (optional)
FRONTEND_PORT=80
BACKEND_PORT=5000
MONGO_PORT=27017
